---
import ButtonLink from "@/components/common/ButtonLink.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { sidebarLayoutConfig, siteConfig } from "@/config";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 专题配置
const hubsConfig = siteConfig.pages?.hubs;
const hubsEnabled = hubsConfig?.enabled ?? false;
const hubsPath = hubsConfig?.path ?? "/hubs/";
const hubsTitle = hubsConfig?.title ?? "专题文章";
const defaultIcon = hubsConfig?.defaultIcon ?? "material-symbols:category-outline";

// 获取所有 Hub 列表
const hubs = hubsEnabled ? await getCollection("hubs") : [];

// 按文章数量降序排序（文章多的专题优先展示）
const sortedHubs = hubs.sort((a, b) => {
	const countA = a.data.spokes?.length || 0;
	const countB = b.data.spokes?.length || 0;
	return countB - countA; // 降序：多的在前
});

// 从配置中获取显示阈值和文章数量开关
const hubsNavConfig = [
	...sidebarLayoutConfig.leftComponents,
	...sidebarLayoutConfig.rightComponents,
	...sidebarLayoutConfig.mobileBottomComponents,
].find((c) => c.type === "hubsNav");

const displayLimit = hubsNavConfig?.responsive?.collapseThreshold ?? 8;
const showArticleCount = hubsNavConfig?.responsive?.showArticleCount ?? false;

// 展示文章数量前 N 的专题
const displayedHubs = sortedHubs.slice(0, displayLimit);

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

{hubsEnabled && sortedHubs.length > 0 && (
	<WidgetLayout 
		name={hubsTitle} 
		id="hubsNav" 
		class={className} 
		style={style}
	>
		{displayedHubs.map((hub) => (
			<ButtonLink
				url={`${hubsPath}${hub.data.slug}/`}
				badge={showArticleCount ? String(hub.data.spokes?.length || 0) : undefined}
				label={`查看专题：${hub.data.title}`}
			>
				<div class="flex items-center gap-2">
<div class="h-5 w-5 rounded bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
	<Icon name={hub.data.icon || defaultIcon} class="text-sm" />
</div>
					<span class="truncate">{hub.data.title}</span>
				</div>
			</ButtonLink>
		))}
		<div class="expand-btn px-4 mb-1">
			<a 
				href={hubsPath}
				class="btn-plain rounded-lg w-full h-9 flex items-center justify-center gap-2 text-(--primary)"
			>
				<Icon name="material-symbols:more-horiz" class="text-[1.75rem]" />
				{i18n(I18nKey.more)}
			</a>
		</div>
	</WidgetLayout>
)}