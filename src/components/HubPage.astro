---
import { getCollection, render } from 'astro:content';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import { Icon } from 'astro-icon/components';
import { getSortedPosts } from '@utils/content-utils';

interface Props {
  hub: {
    id: string;
    data: {
      title: string;
      description: string;
      slug: string;
      icon?: string;
      keywords?: string[];
      hero?: {
        headline?: string;
        subheadline?: string;
        cover_image?: string;
      };
      spokes?: Array<{
        slug?: string;
        custom_title?: string;
        custom_description?: string;
        title?: string;
        url?: string;
        description?: string;
        is_external?: boolean;
      }>;
      auto_spokes?: {
        enabled: boolean;
        category?: string;
        tags?: string[];
        sort_by?: 'published' | 'updated' | 'title';
        order?: 'asc' | 'desc';
        limit?: number;
      };
      config?: {
        show_publish_date?: boolean;
        show_reading_time?: boolean;
        show_tags?: boolean;
        external_link_icon?: boolean;
        grid_layout?: boolean;
      };
    };
  };
}

const { hub } = Astro.props;
const data = hub.data;

// 获取所有文章（用于查找内部文章）
const allPosts = await getSortedPosts();

// 解析 spoke 列表：手动 spokes + auto_spokes 追加（去重）
let spokeArticles: any[] = [];
const existingSlugs = new Set<string>();

// 1. 处理手动指定的 spokes
if (data.spokes && data.spokes.length > 0) {
  spokeArticles = data.spokes.map(spoke => {
    if (spoke.slug) {
      // 内部文章 - 通过 slug 查找
      const post = allPosts.find(p =>
        p.id.replace(/\.(md|mdx)$/, '') === spoke.slug ||
        p.data.slug === spoke.slug ||
        p.id.includes(spoke.slug)
      );

      if (!post) {
        // 尝试更宽松的匹配
        const looseMatch = allPosts.find(p =>
          p.id.toLowerCase().includes(spoke.slug!.toLowerCase())
        );
        if (!looseMatch) return null;
        const resolvedSlug = looseMatch.id.replace(/\.(md|mdx)$/, '');
        existingSlugs.add(resolvedSlug);
        return {
          type: 'internal',
          title: spoke.custom_title || looseMatch.data.title,
          description: spoke.custom_description || looseMatch.data.description,
          slug: resolvedSlug,
          published: looseMatch.data.published,
          updated: looseMatch.data.updated,
          tags: looseMatch.data.tags,
          image: looseMatch.data.image,
        };
      }

      const resolvedSlug = post.id.replace(/\.(md|mdx)$/, '');
      existingSlugs.add(resolvedSlug);
      return {
        type: 'internal',
        title: spoke.custom_title || post.data.title,
        description: spoke.custom_description || post.data.description,
        slug: resolvedSlug,
        published: post.data.published,
        updated: post.data.updated,
        tags: post.data.tags,
        image: post.data.image,
      };
    } else if (spoke.title && spoke.url) {
      // 外部链接
      return {
        type: 'external',
        title: spoke.title,
        description: spoke.description || '',
        url: spoke.url,
      };
    }
    return null;
  }).filter(Boolean);
}

// 2. 处理 auto_spokes（追加模式，去重）
if (data.auto_spokes?.enabled) {
  let filtered = [...allPosts];

  if (data.auto_spokes.category) {
    filtered = filtered.filter(p => p.data.category === data.auto_spokes.category);
  }
  if (data.auto_spokes.tags?.length) {
    filtered = filtered.filter(p =>
      data.auto_spokes.tags!.some(tag => p.data.tags?.includes(tag))
    );
  }

  // 排序
  const sortBy = data.auto_spokes.sort_by || 'published';
  const order = data.auto_spokes.order || 'desc';
  filtered = filtered.sort((a, b) => {
    let cmp = 0;
    if (sortBy === 'title') {
      cmp = a.data.title.localeCompare(b.data.title);
    } else {
      const aDate = sortBy === 'updated' ? (a.data.updated || a.data.published) : a.data.published;
      const bDate = sortBy === 'updated' ? (b.data.updated || b.data.published) : b.data.published;
      cmp = new Date(aDate).getTime() - new Date(bDate).getTime();
    }
    return order === 'desc' ? -cmp : cmp;
  });

  // 限制数量
  if (data.auto_spokes.limit) {
    filtered = filtered.slice(0, data.auto_spokes.limit);
  }

  // 追加到 spokeArticles（去重）
  for (const post of filtered) {
    const slug = post.id.replace(/\.(md|mdx)$/, '');
    if (!existingSlugs.has(slug)) {
      existingSlugs.add(slug);
      spokeArticles.push({
        type: 'internal',
        title: post.data.title,
        description: post.data.description,
        slug: slug,
        published: post.data.published,
        updated: post.data.updated,
        tags: post.data.tags,
        image: post.data.image,
      });
    }
  }
}

// 配置默认值
const config = {
  show_publish_date: data.config?.show_publish_date ?? true,
  show_reading_time: data.config?.show_reading_time ?? true,
  show_tags: data.config?.show_tags ?? true,
  external_link_icon: data.config?.external_link_icon ?? true,
  grid_layout: data.config?.grid_layout ?? false,
};

// 格式化日期
function formatDate(date: Date | string): string {
  const d = new Date(date);
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// 计算 Hub 页面的统计信息
const internalArticles = spokeArticles.filter(a => a.type === 'internal');
const totalReadingTime = Math.round(internalArticles.length * 8); // 假设每篇约8分钟
---

<MainGridLayout
  title={data.title}
  description={data.description}
  keywords={data.keywords}
>
  <div class="card-base px-6 md:px-9 py-8 mb-4">

    <!-- Hero 区域 -->
    <section class="hub-hero mb-8">
      <div class="flex items-center gap-3 mb-3">
        <Icon name={data.icon || 'material-symbols:category-search'} class="text-2xl text-(--primary) shrink-0" />
        <h1 class="text-2xl md:text-3xl font-bold text-90">
          {data.hero?.headline || data.title}
        </h1>
      </div>
      
      {data.hero?.subheadline && (
        <p class="text-lg text-75 mb-4">
          {data.hero.subheadline}
        </p>
      )}
      
      <!-- 统计信息 -->
      <div class="flex gap-4 text-sm text-50">
        <span class="flex items-center gap-1.5">
          <Icon name="material-symbols:article-outline" class="text-base" />
          共 {spokeArticles.length} 篇文章
        </span>
        {config.show_reading_time && (
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:schedule-outline-rounded" class="text-base" />
            预计阅读 {totalReadingTime} 分钟
          </span>
        )}
      </div>
    </section>

    <!-- 分隔线 -->
    <div class="border-(--line-divider) border-dashed border-b mb-8"></div>

    <!-- Spoke 列表 -->
    <section class="spokes-container">

      <!-- 列表布局 -->
      {config.grid_layout === false && (
        <div class="space-y-6">
          {spokeArticles.map((article) => (
            <article class="spoke-card group border-b border-(--line-divider) pb-6 last:border-0 last:pb-0">
              {article.type === 'internal' ? (
                <a
                  href={`/posts/${article.slug}/`}
                  class="block hover:no-underline"
                >
                  <!-- 日期 -->
                  {config.show_publish_date && (
                    <time class="text-sm text-50 block mb-2">
                      {formatDate(article.published)}
                    </time>
                  )}
                  
                  <!-- 标题 -->
                  <h2 class="text-lg font-semibold text-90 group-hover:text-(--primary) transition-colors mb-2">
                    {article.title}
                  </h2>
                  
                  <!-- 描述 -->
                  <p class="text-75 text-sm mb-3 line-clamp-4">
                    {article.description}
                  </p>
                  
                  <!-- 标签 -->
                  {config.show_tags && article.tags?.length > 0 && (
                    <div class="flex gap-2 flex-wrap">
                      {article.tags.map((tag: string) => (
                        <a
                          href={`/tags/${tag}/`}
                          class="btn-regular h-6 text-xs px-2 py-1 rounded-md 
                                transition-all duration-200 hover:scale-105 active:scale-95"
                        >
                          #{tag}
                        </a>
                      ))}
                    </div>
                  )}
                </a>
              ) : (
                <!-- 外部链接 -->
                <a
                  href={article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block hover:no-underline"
                >
                  {config.external_link_icon && (
                    <span class="text-sm text-(--primary) flex items-center gap-1 mb-2">
                      <Icon name="material-symbols:link" class="text-base" />
                      外部链接
                    </span>
                  )}
                  
                  <h2 class="text-lg font-semibold text-90 group-hover:text-(--primary) transition-colors mb-2">
                    {article.title}
                  </h2>
                  
                  <p class="text-75 text-sm">
                    {article.description}
                  </p>
                </a>
              )}
            </article>
          ))}
        </div>
      )}

<!-- 网格布局 -->
      {config.grid_layout === true && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {spokeArticles.map((article) => (
            <article class="spoke-card card-base group overflow-hidden hover:bg-(--btn-card-bg-hover) 
                             transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]
                             flex flex-col">
              
              <div class="p-4 flex flex-col h-full">
                {article.type === 'internal' ? (
                  <a href={`/posts/${article.slug}/`} class="block hover:no-underline flex flex-col h-full">
                    {config.show_publish_date && (
                      <time class="text-xs text-50 block mb-2">
                        {formatDate(article.published)}
                      </time>
                    )}
                    
                    <h3 class="text-base font-semibold text-90 mb-2 group-hover:text-(--primary) transition-colors line-clamp-2 leading-tight">
                      {article.title}
                    </h3>
                    
                    <p class="text-sm text-75 line-clamp-2 lg:line-clamp-3 overflow-hidden">
                      {article.description}
                    </p>
                    
                    {config.show_tags && article.tags?.length > 0 && (
                      <div class="flex gap-1 flex-wrap mt-auto pt-3 shrink-0">
                        {article.tags.slice(0, 3).map((tag: string) => (
                          <a
                            href={`/tags/${tag}/`}
                            class="btn-regular h-5 text-xs px-1.5 py-0.5 rounded 
                                  transition-all duration-200 hover:scale-105 active:scale-95"
                          >
                            #{tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </a>
                ) : (
                  <a href={article.url} target="_blank" rel="noopener noreferrer" class="block hover:no-underline flex flex-col h-full">
                    {config.external_link_icon && (
                      <Icon name="material-symbols:link" class="text-(--primary) mb-2 block" />
                    )}
                    
                    <h3 class="text-base font-semibold text-90 mb-2 group-hover:text-(--primary) line-clamp-2 leading-tight transition-colors">
                      {article.title}
                    </h3>
                    
                    <p class="text-sm text-75 line-clamp-2 lg:line-clamp-3 overflow-hidden">
                      {article.description}
                    </p>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      )}

    </section>

  </div>
</MainGridLayout>