---
import { getCollection } from 'astro:content';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/siteConfig';

// 开关关闭时，不渲染任何内容（生成空页面）
// 由于导航栏已隐藏入口，用户不会主动访问

// 获取所有 Hub 配置
const hubs = siteConfig.pages.hubs.enabled ? await getCollection('hubs') : [];

// 按 slug 排序
const sortedHubs = hubs.sort((a, b) => a.data.slug.localeCompare(b.data.slug));

// 索引页元信息（从配置读取）
const hubsPageTitle = siteConfig.pages.hubs.title;
const hubsPageDesc = siteConfig.pages.hubs.description;

// 索引页 ItemList JSON-LD
const hubsItemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": hubsPageTitle,
  "description": hubsPageDesc,
  "numberOfItems": sortedHubs.length,
  "itemListElement": sortedHubs.map((hub, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": hub.data.title,
    "description": hub.data.description,
    "url": `${siteConfig.site_url}/hubs/${hub.data.slug}/`
  }))
};
---

{siteConfig.pages.hubs.enabled ? (
  <MainGridLayout title={hubsPageTitle} description={hubsPageDesc}>
    <div class="card-base px-6 md:px-9 py-8 mb-4">
      <!-- 页面标题 -->
      <section class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold mb-3 text-neutral-900 dark:text-neutral-100">
          {hubsPageTitle}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400">
          按主题聚合相关文章，方便系统性阅读
        </p>
      </section>

      <!-- Hub 卡片网格（一行两个） -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {sortedHubs.map(hub => (
          <a
            href={`/hubs/${hub.data.slug}/`}
            class="card-base group block p-4 md:p-6 hover:bg-(--btn-card-bg-hover) 
                   flex flex-col overflow-hidden transition-all duration-200 
                   hover:scale-[1.02] active:scale-[0.98]"
          >
            <!-- 标题区域 -->
            <div class="flex items-center gap-3 mb-2">
              <Icon name={hub.data.icon || 'material-symbols:category-search'} class="text-xl text-(--primary) shrink-0" />
              <h2 class="text-lg font-semibold text-90 group-hover:text-(--primary) transition-colors line-clamp-2 leading-tight">
                {hub.data.title}
              </h2>
            </div>

            <!-- 描述区域（移动端 2 行，PC 3 行） -->
            <p class="text-sm text-75 line-clamp-2 lg:line-clamp-3 overflow-hidden">
              {hub.data.description}
            </p>

            <!-- 统计区域 -->
            <div class="flex items-center gap-2 text-xs text-50 mt-auto pt-3 shrink-0">
              <Icon name="material-symbols:article-outline" class="text-sm" />
              <span>{hub.data.spokes?.length || 0} 篇文章</span>
            </div>
          </a>
        ))}
      </div>

      <!-- 空状态 -->
      {sortedHubs.length === 0 && (
        <div class="text-center py-12 text-neutral-500 dark:text-neutral-400">
          <Icon name="material-symbols:folder-off-outline" class="text-4xl mb-3" />
          <p>暂无专题内容</p>
        </div>
      )}
    </div>
    
    <!-- JSON-LD 注入到 head -->
    {sortedHubs.length > 0 && (
      <script type="application/ld+json" slot="head" set:html={JSON.stringify(hubsItemListJsonLd)} />
    )}
  </MainGridLayout>
) : (
  <!-- 开关关闭时渲染空页面 -->
  <MainGridLayout title={hubsPageTitle}>
    <div class="card-base px-6 py-8 text-center">
      <p class="text-neutral-500">专题功能已关闭</p>
    </div>
  </MainGridLayout>
)}