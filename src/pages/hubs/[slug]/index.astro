---
import { getCollection } from 'astro:content';
import HubPage from '@components/layout/HubPage.astro';
import { siteConfig } from '@/config/siteConfig';
import { getSortedPosts } from '@utils/content-utils';
import { profileConfig } from '@/config/profileConfig';

// 静态路径生成 - 第1页
export async function getStaticPaths() {
  const HUB_PAGE_SIZE = siteConfig.pagination.postsPerPage;
  
  if (!siteConfig.pages.hubs.enabled) {
    return [];
  }
  
  const hubs = await getCollection('hubs');
  const allPosts = await getSortedPosts();
  const siteUrl = siteConfig.site_url;
  
  return hubs.map(hub => {
    const data = hub.data;
    const hubUrl = `${siteUrl}/hubs/${data.slug}/`;
    const hubsIndexUrl = `${siteUrl}/hubs/`;
    
    // 解析 spokes（仅内部文章）
    const spokeItems = (data.spokes || []).map(spoke => {
      if (!spoke.slug) return { name: '', url: '' };
      
      const post = allPosts.find(p => {
        if (p.data.slug === spoke.slug) return true;
        if (p.id.replace(/\.(md|mdx)$/, '') === spoke.slug) return true;
        return false;
      });
      return {
        name: spoke.custom_title || (post?.data?.title || ''),
        url: `${siteUrl}/posts/${spoke.slug}/`
      };
    }).filter(item => item.name && item.url);
    
    // 计算总页数
    const totalArticles = spokeItems.length;
    const totalPages = Math.ceil(totalArticles / HUB_PAGE_SIZE);
    
    // BreadcrumbList JSON-LD
    const breadcrumbJsonLd = {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "专题文章",
          "item": hubsIndexUrl
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": data.title,
          "item": hubUrl
        }
      ]
    };
    
    // CollectionPage JSON-LD
    const collectionPageJsonLd = {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": hubUrl,
      "name": data.title,
      "description": data.description,
      "url": hubUrl,
      "author": {
        "@type": "Person",
        "name": profileConfig.name,
        "url": `${siteUrl}/about/`
      },
      "isPartOf": {
        "@type": "CollectionPage",
        "@id": hubsIndexUrl,
        "name": "专题文章"
      },
      "mainEntity": {
        "@type": "ItemList",
        "@id": `${hubUrl}#itemlist`,
        "numberOfItems": spokeItems.length,
        "itemListElement": spokeItems.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": item.name,
          "url": item.url
        }))
      }
    };
    
    return {
      params: { slug: data.slug },
      props: {
        hub,
        currentPage: 1,
        totalPages,
        pageSize: HUB_PAGE_SIZE,
        breadcrumbJsonLd,
        collectionPageJsonLd
      }
    };
  });
}

const { hub, currentPage, totalPages, pageSize, breadcrumbJsonLd, collectionPageJsonLd } = Astro.props;
---

{siteConfig.pages.hubs.enabled && hub && (
  <HubPage
    hub={hub}
    currentPage={currentPage}
    totalPages={totalPages}
    pageSize={pageSize}
    canonical={new URL(`/hubs/${hub.data.slug}/`, Astro.url)}
  >
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionPageJsonLd)} />
  </HubPage>
)}